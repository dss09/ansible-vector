# Set global options
data_dir = "/var/lib/vector"

{% set loop_helper = {
    "sources": (sources | default({})),
    "transforms": (transforms | default({})),
    "sinks": (sinks | default({}))
} %}

{% for name, cat in loop_helper | dictsort %}
{% for key, value in cat | dictsort %}
[{{ name }}.{{ key }}]
  {% if value %}
  {%- for skey, svalue in value | dictsort %}
{%- if svalue is string %}
  {{ skey }} = "{{ svalue }}"
{% else %}
  {{ skey }} = {{ svalue | tojson }}
{% endif %}
  {% endfor %}
  {%- endif %}

{% endfor %}
{% endfor %}
